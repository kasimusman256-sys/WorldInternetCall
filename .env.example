# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# --- Supabase ---
# Public/anon values only. These are safe to expose in a frontend build,
# but Row Level Security must be enabled on every table in Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Africa's Talking Voice (future integration) ---
# Do NOT put your real Africa's Talking API key here or anywhere in
# frontend code. Voice calls must be brokered by a backend/server
# (e.g. a Supabase Edge Function) that holds the secret key and talks
# to Africa's Talking on the client's behalf.
# This value only tells the frontend which backend endpoint to call.
VITE_VOICE_BRIDGE_URL=https://your-backend.example.com/api/voice
